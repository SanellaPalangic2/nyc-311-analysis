table fact_requests
	lineageTag: 3ed79dce-5acc-52c3-bfce-cd052604efed

	measure Requests = COUNTROWS ( fact_requests )
		formatString: #,0
		lineageTag: 2a76d41f-8196-5316-a071-163be28675ef

	measure 'Median Hours' =
			CALCULATE (
			    MEDIAN ( fact_requests[resolution_hours] ),
			    fact_requests[resolution_status] = "closed"
			)
		formatString: #,0.00
		lineageTag: 056635f3-0f25-5c78-a14c-d6f63b07543a

	measure 'P90 Hours' =
			CALCULATE (
			    PERCENTILE.INC ( fact_requests[resolution_hours], 0.9 ),
			    fact_requests[resolution_status] = "closed"
			)
		formatString: #,0.00
		lineageTag: 0d698379-00fa-57fe-a714-9850904a1135

	measure 'Mean Hours' =
			CALCULATE (
			    AVERAGE ( fact_requests[resolution_hours] ),
			    fact_requests[resolution_status] = "closed"
			)
		formatString: #,0.00
		lineageTag: b7d27946-7cc0-524a-bd3c-bbcbc61e902c

	measure 'Median Days' = DIVIDE ( [Median Hours], 24 )
		formatString: #,0.00
		lineageTag: 1bd20ad5-dbbb-593d-80b1-5c5f4b79f82d

	measure '% Closed Within 30 Days' =
			DIVIDE (
			    SUM ( fact_requests[closed_within_30d] ),
			    SUM ( fact_requests[outcome_30d_known] )
			)
		formatString: 0.00%
		lineageTag: 57a35aa3-9fe3-51c2-ae83-d68702a1ab21

	measure '% No Close Date' = DIVIDE ( SUM ( fact_requests[has_no_close_date] ), [Requests] )
		formatString: 0.00%
		lineageTag: 7d58d7a0-9bae-580b-b78b-e1130fd2d9a9

	measure '% NYPD' =
			DIVIDE (
			    CALCULATE ( [Requests], fact_requests[agency_group] = "NYPD" ),
			    [Requests]
			)
		formatString: 0.00%
		lineageTag: 77bdd2ab-70a4-569f-8ee1-a5da36f94662

	measure 'Citywide Median Hours' =
			CALCULATE (
			    [Median Hours],
			    REMOVEFILTERS ( dim_borough ),
			    dim_borough[is_known] = 1
			)
		formatString: #,0.00
		lineageTag: 36f0c4b4-2f13-5784-9ae1-cf71904d4e7f

	measure 'Ratio to Citywide' = DIVIDE ( [Median Hours], [Citywide Median Hours] )
		formatString: 0.00"x"
		lineageTag: bd217d48-3e5a-546c-9d63-8c2c1367bce2

	measure 'No Close Date Color' = IF ( [% No Close Date] >= 0.2, "#eb6834", BLANK () )
		lineageTag: 8b169cab-c3b6-5d42-8efa-23c847e33534

	column unique_key
		dataType: int64
