		sourceColumn: is_zero_duration
		lineageTag: 654dc17e-d196-57d1-8998-02c19456288b

	partition fact_requests = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_requests.csv"), [Delimiter = ",", Columns = 15, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"unique_key", Int64.Type}, {"created_date", type date}, {"created_month", Int64.Type}, {"season", type text}, {"agency", type text}, {"agency_group", type text}, {"complaint_type", type text}, {"borough", type text}, {"resolution_status", type text}, {"resolution_hours", type number}, {"has_no_close_date", Int64.Type}, {"outcome_30d_known", Int64.Type}, {"closed_within_30d", Int64.Type}, {"is_extreme", Int64.Type}, {"is_zero_duration", Int64.Type}}, "en-US")
				in
				    Typed
