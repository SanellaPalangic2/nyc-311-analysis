# --- Secrets ---------------------------------------------------------------
# .env holds the database password and Socrata token. Never commit it.
.env

# --- Python ----------------------------------------------------------------
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# --- Data files ------------------------------------------------------------
# Raw and processed data are large and can be re-downloaded with the scripts,
# so they stay out of git. The .gitkeep files keep the empty folders in the repo.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# CSV exports for Power BI are data too (regenerate them with the export script).
outputs/powerbi/*
!outputs/powerbi/.gitkeep

# Power BI Project (powerbi/): the text files are committed, but Power BI
# Desktop also writes a .pbi folder per item: local data cache (holds all
# imported rows), editor and per-user settings. None of it belongs in git.
powerbi/**/.pbi/

# Power BI files embed the imported data, so they're data too.
# To publish the dashboard file, check it's under GitHub's 100 MB limit, then
# un-comment the line below (it re-includes this one file).
*.pbix
# !outputs/nyc311_dashboard.pbix

# Catch-all for data formats anywhere in the repo
*.csv
*.parquet
*.json.gz
# ...except the dashboard's small pre-aggregated files, which the deployed app
# needs (no raw rows: ~0.1 MB of summaries, built by analysis/build_app_data.py)
!app/data/*.parquet

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
Thumbs.db
.DS_Store
