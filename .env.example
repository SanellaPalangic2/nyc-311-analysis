# Copy this file to .env and fill in your own values.
# .env is git-ignored; this example file is safe to commit.

# Optional. A free Socrata app token raises the API rate limit.
# Get one at https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/nyc311
